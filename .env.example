# Model for the retail_support reference agent. Any string the ADK
# LLMRegistry resolves, including a LiteLLM prefix form
# (e.g. "litellm/anthropic/claude-sonnet-5-5").
EVAL_BIBLE_AGENT_MODEL=

# Model for the judge used when grading demo runs. Same resolution rules
# as EVAL_BIBLE_AGENT_MODEL; by default pick a different model family
# than the agent.
EVAL_BIBLE_JUDGE_MODEL=
